# ==============================================================================
# MedStock AI Backend Configuration (Phase 2 - MySQL)
# ==============================================================================

# Application Environment (development, staging, production)
ENVIRONMENT=development
PROJECT_NAME="MedStock AI Backend"
API_V1_STR="/api"

# Server Settings
HOST=127.0.0.1
PORT=8000

# CORS Allowed Origins (comma-separated list for Vite frontend development)
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000"

# MySQL Database Connection Settings (Local MySQL Server)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password_here
MYSQL_DATABASE=medstock_ai

# Optional: Direct Database Connection URL override
# If provided, this overrides the individual MYSQL_* settings above
# Format: mysql+pymysql://USER:PASSWORD@HOST:PORT/DATABASE?charset=utf8mb4
# DATABASE_URL=mysql+pymysql://root:your_mysql_password_here@127.0.0.1:3306/medstock_ai?charset=utf8mb4
